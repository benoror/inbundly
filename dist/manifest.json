{
    "name": "Inbundly – Inbox Bundles for Gmail",
    "version": "4.0.0",
    "description": "Bring Google Inbox-style bundles to Gmail: auto-group emails by label into tidy, collapsible bundles. Organize your inbox, fast.",
    "homepage_url": "https://inbundly.com",
    "key": "",
    "browser_specific_settings": {
        "gecko": {
            "id": "inbundly@benoror.github.io"
        }
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [{
        "matches": ["*://mail.google.com/mail/*"],
        "js": ["content.js"],
        "css": ["style.css"],
        "run_at": "document_start",
        "all_frames": false
    }],
    "options_ui": {
        "page": "options/options.html",
        "browser_style": false,
        "open_in_tab": true
    },
    "permissions": [
        "storage",
        "declarativeContent"
    ],
    "action": {
        "default_icon": {
            "16": "icons/inbundly-dark-16.png",
            "24": "icons/inbundly-dark-24.png",
            "32": "icons/inbundly-dark-32.png",
            "48": "icons/inbundly-dark-48.png"
        },
        "theme_icons": [
            { "light": "icons/inbundly-dark-16.png", "dark": "icons/inbundly-light-16.png", "size": 16 },
            { "light": "icons/inbundly-dark-24.png", "dark": "icons/inbundly-light-24.png", "size": 24 },
            { "light": "icons/inbundly-dark-32.png", "dark": "icons/inbundly-light-32.png", "size": 32 },
            { "light": "icons/inbundly-dark-48.png", "dark": "icons/inbundly-light-48.png", "size": 48 }
        ],
        "default_popup": "popup/popup.html",
        "show_matches": ["*://mail.google.com/mail/*"]
    },
    "icons": {
        "16": "icons/inbundly-dark-16.png",
        "32": "icons/inbundly-dark-32.png",
        "48": "icons/inbundly-dark-48.png",
        "128": "icons/inbundly-dark-128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [ "assets/*.svg" ],
            "matches": [ "https://mail.google.com/*" ]
        }
    ],
    "manifest_version": 3
}